{
  "name": "dialogue",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DIAlogue: a diabetes education assistant inside a mock patient portal. Browser-only, hosted on GitHub Pages.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest",
    "typecheck": "vue-tsc --build",
    "gate": "vue-tsc --build && vitest run && vite build",
    "test:db": "vitest run --config vitest.db.config.ts",
    "kb:build": "node kb/build.ts",
    "kb:load": "node --env-file=.env.local kb/load.ts",
    "kb:cards:check": "node kb/cards-check.ts",
    "kb:cards:load": "node --env-file=.env.local kb/cards-load.ts",
    "kb:cards:approve": "node --env-file=.env.local kb/cards-approve.ts",
    "kb:faq-compare": "node kb/faq-compare.ts",
    "kb:eval-faq": "node --env-file=.env.local node_modules/jiti/lib/jiti-cli.mjs kb/eval-faq.ts",
    "kb:eval-routing": "node --env-file=.env.local node_modules/jiti/lib/jiti-cli.mjs kb/eval-routing.ts",
    "kb:eval-plan": "node --env-file=.env.local node_modules/jiti/lib/jiti-cli.mjs kb/eval-plan.ts",
    "kb:eval-clinician": "node --env-file=.env.local node_modules/jiti/lib/jiti-cli.mjs kb/eval-clinician.ts",
    "patients:load": "node --env-file=.env.local patients/load.ts"
  },
  "dependencies": {
    "dompurify": "^3.4.17",
    "marked": "^18.2.0",
    "vue": "^3.5.45"
  },
  "devDependencies": {
    "@neon/config": "^1.14.0",
    "@neon/env": "^2.1.3",
    "@neondatabase/serverless": "^1.2.1",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vue/tsconfig": "^0.9.1",
    "jsdom": "^26.1.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14"
  }
}
